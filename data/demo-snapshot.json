  "title": "Harbor SDK: 1.8 to 2.0",
  "sources": [
    {
      "title": "Harbor 2.0 release notes",
      "version": "2.0",
      "text": "Removed `retry_limit`; configure `retry_policy` instead.\nDeprecated `legacy_auth`; it remains available until version 3.0.\nAdded `export_batch` for bulk report exports.\nFixed an authentication bypass in `session_check`.\nCorrected a sorting bug in `list_orders`.",
      "url": "",
      "license": "Original synthetic demo, MIT. Not a real package advisory.",
      "id": "s-b8afaff518dc06ad62e6",
      "sha256": "28af8500206828d470525af437e0b553b958eeab9826d0b3b8062041472bd057"
    },
    {
      "title": "Harbor 2.0 configuration reference",
      "version": "2.0",
      "text": "The `retry_limit` setting remains supported in version 2.0.\nThe `retry_policy` setting controls retry delays and maximum attempts.\nThe `export_batch` API supports JSON and CSV output.\nThe `legacy_auth` adapter is deprecated but still works.",
      "url": "",
      "license": "Original synthetic demo, MIT. Not a real package advisory.",
      "id": "s-6fb3f1a904da22b9fc24",
      "sha256": "dbb86c775d5231ecfca450dc657bc24328f55cd67a21a50c812184936d014d6c"
    },
    {
      "title": "Harbor 1.8 reference snapshot",
      "version": "1.8",
      "text": "The `retry_limit` setting is supported in version 1.8.\nThe `legacy_auth` adapter is available for existing applications.\nUse `list_orders` to fetch customer order history.",
      "url": "",
      "license": "Original synthetic demo, MIT. Not a real package advisory.",
      "id": "s-26aabfe080718f215ade",
      "sha256": "ebf7aea980a6722163294abb8ec5fcad43cebb7f9035eb38e30e1a5771f872f3"
    }
