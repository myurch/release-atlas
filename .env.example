# Reference only. The server reads environment variables, not this file automatically.
ATLAS_LLM_KIND=ollama
ATLAS_LLM_BASE=http://localhost:11434
ATLAS_LLM_MODEL=gpt-oss:20b
# ATLAS_LLM_KEY=server-side-secret
# Optional separate embedding model, never assume the generation model supports it.
# ATLAS_EMBED_KIND=ollama
# ATLAS_EMBED_BASE=http://localhost:11434
# ATLAS_EMBED_MODEL=your-installed-embedding-model
# ATLAS_EMBED_KEY=server-side-secret
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8765
ATLAS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# ATLAS_DATA_DIR=/absolute/private/data/directory
# ATLAS_ACCESS_CODE=use-a-long-random-shared-code
# Set only with HTTPS reverse proxy:
# ATLAS_COOKIE_SECURE=1
