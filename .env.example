# Copy to .env in the repository root. Startup loads .env; terminal variables win.
# .env is private and ignored by Git. Do not put a real key in this example.
ATLAS_LLM_KIND=openai
ATLAS_LLM_BASE=https://api.openai.com/v1
ATLAS_LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
# ATLAS_LLM_KEY is an optional server-side override. Never put a real key here.
# Optional separate embedding model, never assume the generation model supports it.
# ATLAS_EMBED_KIND=ollama
# ATLAS_EMBED_BASE=http://localhost:11434
# ATLAS_EMBED_MODEL=your-installed-embedding-model
# ATLAS_EMBED_KEY=server-side-secret
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8765
ATLAS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# ATLAS_DATA_DIR=/absolute/private/data/directory
# Sign-in is disabled by default. Set to 1 and restart to require a shared code.
ATLAS_AUTH_ENABLED=0
# Used only when authentication is enabled:
# ATLAS_ACCESS_CODE=use-a-long-random-shared-code
# Set only with HTTPS reverse proxy:
# ATLAS_COOKIE_SECURE=1

# Ask Atlas retrieval: local neural encoder when installed, labeled LSA fallback otherwise.
# Install once with: sh install-release-atlas-semantic.sh
ATLAS_RETRIEVAL_ENCODER=auto
# Choose statistical to disable the optional local neural worker.
# ATLAS_RETRIEVAL_PYTHON=/absolute/path/to/compatible/python
